{
  "_comment": "Single source of truth for project-level <KEY> placeholders. init.py consumes it for replacement and --check, and it guides the agent. It does not include local template tokens (TICKET_ID, CRITERION_1, DATE, NNN, ALTERNATIVE_1, SUBTASK_1, RISK, CHANGE_1, ENV_STEPS, ENV, CONSEQUENCE_*) filled when each template is used, or convention examples (PLACEHOLDER, UPPER_SNAKE). kind: mechanical=known value; judgment=requires a decision (a good candidate for agent reasoning or discussion). TASK_TRACKER, SECRETS_PROVIDER, and CODE_INTELLIGENCE are enums: their values select provider catalog fragments that init.py composes into docs/bindings.md.",
  "placeholders": [
    {"key": "PROJECT_NAME", "prompt": "Project name", "default": "", "kind": "mechanical", "required": true},
    {"key": "REPO_LANGUAGE", "prompt": "Persistence language (ISO code, e.g. en or es)", "default": "en", "kind": "judgment", "required": true},
    {"key": "FACTORY_SPEC", "prompt": "Organization baseline governing this repo (org/factory@vX; empty if not applicable)", "default": "", "kind": "mechanical", "required": false},
    {"key": "FACTORY_REQUIRED", "prompt": "Is factory membership required? (true/false: when true, FACTORY_SPEC is required)", "default": "false", "kind": "mechanical", "required": false, "enum": ["true", "false"]},
    {"key": "INTEGRATION_BRANCH", "prompt": "Integration branch", "default": "main", "kind": "mechanical", "required": true},
    {"key": "REPO_URLS", "prompt": "Repository URL(s)", "default": "", "kind": "mechanical", "required": false},
    {"key": "LANGUAGES_AND_FRAMEWORKS", "prompt": "Stack languages and frameworks", "default": "", "kind": "mechanical", "required": false},
    {"key": "PACKAGE_MANAGER", "prompt": "Package manager", "default": "", "kind": "mechanical", "required": false},
    {"key": "TRACKER", "prompt": "Task tracker (Jira / GitHub Issues / Linear / ...)", "default": "", "kind": "mechanical", "required": false},
    {"key": "TRACKER_KEY", "prompt": "Project or board inside the tracker", "default": "", "kind": "mechanical", "required": false},
    {"key": "EPIC_ID", "prompt": "Default epic or milestone ID (if applicable)", "default": "", "kind": "mechanical", "required": false},
    {"key": "TASK_TRACKER", "prompt": "Task provider", "default": "", "kind": "mechanical", "required": true, "enum": ["jira", "github-issues", "github-projects", "linear", "custom"]},
    {"key": "SECRETS_PROVIDER", "prompt": "Secrets manager", "default": "none", "kind": "mechanical", "required": false, "enum": ["infisical", "vault", "doppler", "none", "custom"]},
    {"key": "CODE_INTELLIGENCE", "prompt": "Structural code intelligence provider", "default": "none", "kind": "mechanical", "required": false, "enum": ["none", "codegraph", "custom"]},
    {"key": "SECRETS_PATH", "prompt": "Secret path or mount in the manager (if applicable)", "default": "", "kind": "mechanical", "required": false},
    {"key": "BRANCHING_MODEL", "prompt": "Branching model (trunk-based / GitHub flow / ...)", "default": "trunk-based", "kind": "judgment", "required": false},
    {"key": "BRANCH_NAMING", "prompt": "Branch naming convention", "default": "<type>/<TICKET_ID>-<short-slug>", "kind": "mechanical", "required": false},
    {"key": "BUILD_CMD", "prompt": "Build command", "default": "", "kind": "mechanical", "required": false},
    {"key": "TEST_CMD", "prompt": "Test command", "default": "", "kind": "mechanical", "required": false},
    {"key": "LINT_CMD", "prompt": "Lint command", "default": "", "kind": "mechanical", "required": false},
    {"key": "TYPECHECK_CMD", "prompt": "Typecheck command (if applicable)", "default": "", "kind": "mechanical", "required": false},
    {"key": "RUN_CMD", "prompt": "Command to run the app locally", "default": "", "kind": "mechanical", "required": false},
    {"key": "ENVIRONMENTS", "prompt": "Environments and how each is deployed (dev/staging/prod)", "default": "", "kind": "mechanical", "required": false},
    {"key": "DEPLOY_METHOD", "prompt": "Deployment method", "default": "", "kind": "mechanical", "required": false},
    {"key": "CI_SYSTEM", "prompt": "CI system", "default": "GitHub Actions", "kind": "mechanical", "required": false},
    {"key": "CI_STACKS", "prompt": "CI ecosystems, comma-separated (rust, typescript, python, go)", "default": "", "kind": "mechanical", "required": false},
    {"key": "OPENCODE_PLUGIN", "prompt": "Enable the optional OpenCode startup plugin? (true/false)", "default": "false", "kind": "judgment", "required": false, "enum": ["true", "false"]},
    {"key": "FORMATTER", "prompt": "Code formatter", "default": "", "kind": "mechanical", "required": false},
    {"key": "LINTER", "prompt": "Linter", "default": "", "kind": "mechanical", "required": false},
    {"key": "TEST_FRAMEWORK", "prompt": "Test framework", "default": "", "kind": "mechanical", "required": false},
    {"key": "SCA_TOOL", "prompt": "Software composition analysis tool (SCA)", "default": "", "kind": "mechanical", "required": false},
    {"key": "OBSERVABILITY_STACK", "prompt": "Observability stack (logs/metrics/traces)", "default": "", "kind": "mechanical", "required": false},
    {"key": "COMMIT_IDENTITY", "prompt": "Commit identity (Name <email>)", "default": "", "kind": "mechanical", "required": false},
    {"key": "REPO_CONVENTIONS_FILE", "prompt": "Destination repository conventions file (if any)", "default": "CONTRIBUTING.md", "kind": "mechanical", "required": false},
    {"key": "TDD_POLICY", "prompt": "TDD policy", "default": "tests-first for non-trivial logic", "kind": "judgment", "required": false},
    {"key": "COVERAGE_TARGET", "prompt": "Coverage target", "default": "behavior coverage; no hard threshold", "kind": "judgment", "required": false},
    {"key": "APPROVAL_GATED_ACTIONS", "prompt": "Actions requiring human approval", "default": "data migrations, production deployment, mass deletion, release publication", "kind": "judgment", "required": false}
  ]
}
